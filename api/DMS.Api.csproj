<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DMS.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageReference Include="Minio" Version="6.0.2" />
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.8" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.1.2" />
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.68.0.3430" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <!-- Pure C# SMB2/3 client — lets Scheduled Backups write directly to a
         Windows/AD network share using credentials entered in the GUI,
         with no host-level CIFS mount required. Version picked from memory
         in an offline environment — if `docker compose build api` reports
         it can't be found/restored, tell me the exact NuGet error and the
         version number will be corrected. -->
    <PackageReference Include="SMBLibrary" Version="1.5.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded inline (Content-ID) in outgoing notification emails — see EmailService.cs -->
    <Content Include="Assets\si-ware-logo-dark.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>

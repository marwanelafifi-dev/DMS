# Copy this file to `.env` and adjust as needed. NEVER commit the real .env.
# The same values work on Windows (local) and Ubuntu (exposure) — only hostnames
# for the tunnel differ, and those are set in Cloudflare, not here.

# --- PostgreSQL ---
POSTGRES_USER=dms_app
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=dms
POSTGRES_PORT=5432

# --- MinIO (object storage) ---
MINIO_ROOT_USER=dms_minio
MINIO_ROOT_PASSWORD=change_me_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Redis ---
REDIS_PORT=6379

# --- JWT (local login sessions) ---
JWT_SECRET=change_me_dev_only_jwt_secret_local_dev

# --- Google Sign-In (Identity Services, ID-token verification — no secret needed) ---
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# under the si-ware.com Workspace org, with this app's origin(s) as authorized
# JavaScript origins. Only @si-ware.com accounts are allowed to sign in — this
# is enforced server-side regardless of what's configured here.
GOOGLE_CLIENT_ID=

# --- Per-user Google Calendar sync (Reminders page "Connect Google Calendar") ---
# Reuses the same OAuth Client ID above — just add a Client Secret to it (or
# create a second Web application client) in Google Cloud Console, enable the
# Google Calendar API for the project, and add
# GOOGLE_CALENDAR_REDIRECT_URI below as an Authorized redirect URI on that
# client (Google redirects the browser here directly after consent, so it
# must be reachable — not the frontend's own URL).
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5174/api/googlecalendar/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:5174/

# --- SMTP (real email delivery, e.g. ISO meeting reminders) ---
# A Google Workspace/Gmail account with 2-Step Verification on and an App
# Password generated at myaccount.google.com/apppasswords (not the regular
# login password — Gmail SMTP rejects that for third-party apps).
SMTP_USER=
SMTP_PASSWORD=

# --- Application service ports (host side) ---
API_PORT=8080
OCR_PORT=8000
# NOTE: intentionally different from Vite's default dev-server port (5173) so
# `docker compose up` never silently shadows `npm run dev` on the same port.
WEB_PORT=5174

# --- API Gateway (Traefik) — optional single entry point in front of web+api ---
# Purely additive: WEB_PORT/API_PORT above still work unchanged. Point a load
# balancer or DNS at GATEWAY_PORT once ready to use this as the real front door.
GATEWAY_PORT=8888
GATEWAY_DASHBOARD_PORT=8090

# --- Cloudflare Tunnel (Stage 2 / Ubuntu only) ---
# Create a tunnel in the Cloudflare Zero Trust dashboard and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional OpenAI-compatible or Anthropic provider for grounded chatbot answer synthesis.
# Without these values the chatbot still returns permission-filtered OCR/task search results.
AI_CHAT_API_KEY=
AI_CHAT_PROVIDER=openai-compatible
AI_CHAT_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_CHAT_MODEL=gpt-4.1-mini
